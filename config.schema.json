{
  "pluginAlias": "TESmart",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Control your TESmart HDMI/KVM switches through Apple HomeKit. For help and examples, see the [README](https://github.com/thehammer/homebridge-tesmart#readme).",
  "footerDisplay": "For support, please visit the [GitHub Issues](https://github.com/thehammer/homebridge-tesmart/issues) page.",
  "schema": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "TESmart",
        "description": "Name for this platform (usually just 'TESmart')"
      },
      "enableDiscovery": {
        "title": "Enable Network Discovery",
        "type": "boolean",
        "default": false,
        "description": "Automatically discover TESmart switches on your local network. Discovered switches will be added automatically."
      },
      "discoverySubnet": {
        "title": "Discovery Subnet (Optional)",
        "type": "string",
        "placeholder": "192.168.1",
        "description": "Limit discovery to a specific subnet (e.g., '192.168.1'). Leave empty to scan all local networks.",
        "condition": {
          "functionBody": "return model.enableDiscovery === true;"
        }
      },
      "switches": {
        "title": "Switches",
        "type": "array",
        "description": "Manually configure TESmart HDMI/KVM switches. Each switch will appear as a Television accessory in HomeKit. Leave empty if using network discovery.",
        "items": {
          "title": "Switch",
          "type": "object",
          "required": ["label", "ip_address"],
          "properties": {
            "label": {
              "title": "Switch Label",
              "type": "string",
              "placeholder": "Living Room HDMI Switch",
              "description": "Friendly name for this switch (will appear in HomeKit)"
            },
            "ip_address": {
              "title": "IP Address",
              "type": "string",
              "format": "ipv4",
              "placeholder": "192.168.1.10",
              "description": "Static IP address of your TESmart switch. Make sure to assign a static IP in your router."
            },
            "model": {
              "title": "Model",
              "type": "string",
              "default": "16x1",
              "oneOf": [
                { "title": "8-Port (8x1)", "enum": ["8x1"] },
                { "title": "16-Port (16x1)", "enum": ["16x1"] }
              ],
              "description": "Select your switch model. This determines how many inputs are available."
            },
            "polling_interval": {
              "title": "Polling Interval (ms)",
              "type": "integer",
              "default": 1000,
              "minimum": 500,
              "maximum": 10000,
              "description": "How often to check the active input (in milliseconds). Default is 1000ms (1 second).",
              "condition": {
                "functionBody": "return !model.switches[arrayIndices].disable_polling;"
              }
            },
            "disable_polling": {
              "title": "Disable Polling",
              "type": "boolean",
              "default": false,
              "description": "Disable automatic polling of the switch state. When enabled, HomeKit can still control the switch, but changes made outside of HomeKit (physical buttons, IR remote) will not be detected. This provides one-way control only."
            },
            "mute_buzzer": {
              "title": "Mute Buzzer",
              "type": "boolean",
              "default": false,
              "description": "Mute the switch buzzer sound when changing inputs. The buzzer will beep by default."
            },
            "led_timeout": {
              "title": "LED Timeout",
              "type": "string",
              "default": "never",
              "oneOf": [
                { "title": "Always On", "enum": ["never"] },
                { "title": "10 Seconds", "enum": ["10s"] },
                { "title": "30 Seconds", "enum": ["30s"] }
              ],
              "description": "How long the front panel LED stays on after switching inputs. 'Always On' keeps LEDs lit continuously."
            },
            "inputs": {
              "title": "Inputs",
              "type": "array",
              "description": "Configure HDMI inputs for this switch. Drag and drop to reorder how they appear in HomeKit.",
              "items": {
                "title": "Input",
                "type": "object",
                "required": ["physicalInput", "label"],
                "properties": {
                  "physicalInput": {
                    "title": "Physical Input Number",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16,
                    "description": "Which physical input port on the switch (1-16)"
                  },
                  "enabled": {
                    "title": "Show in HomeKit",
                    "type": "boolean",
                    "default": true,
                    "description": "Whether this input should be visible in HomeKit"
                  },
                  "label": {
                    "title": "Label",
                    "type": "string",
                    "placeholder": "Apple TV",
                    "description": "Friendly name for this input"
                  }
                }
              }
            },
            "input1": {
              "title": "Input 1",
              "type": "object",
              "properties": {
                "enabled": {
                  "title": "Show in HomeKit",
                  "type": "boolean",
                  "default": true,
                  "description": "Whether this input should be visible in HomeKit"
                },
                "label": {
                  "title": "Label",
                  "type": "string",
                  "default": "Input 1",
                  "placeholder": "Apple TV",
                  "description": "Friendly name for this input"
                }
              }
            },
            "input2": {
              "title": "Input 2",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 2", "placeholder": "PlayStation 5" }
              }
            },
            "input3": {
              "title": "Input 3",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 3", "placeholder": "Xbox Series X" }
              }
            },
            "input4": {
              "title": "Input 4",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 4" }
              }
            },
            "input5": {
              "title": "Input 5",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 5" }
              }
            },
            "input6": {
              "title": "Input 6",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 6" }
              }
            },
            "input7": {
              "title": "Input 7",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 7" }
              }
            },
            "input8": {
              "title": "Input 8",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 8" }
              }
            },
            "input9": {
              "title": "Input 9",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 9" }
              }
            },
            "input10": {
              "title": "Input 10",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 10" }
              }
            },
            "input11": {
              "title": "Input 11",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 11" }
              }
            },
            "input12": {
              "title": "Input 12",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 12" }
              }
            },
            "input13": {
              "title": "Input 13",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 13" }
              }
            },
            "input14": {
              "title": "Input 14",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 14" }
              }
            },
            "input15": {
              "title": "Input 15",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 15" }
              }
            },
            "input16": {
              "title": "Input 16",
              "type": "object",
              "properties": {
                "enabled": { "title": "Show in HomeKit", "type": "boolean", "default": true },
                "label": { "title": "Label", "type": "string", "default": "Input 16" }
              }
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "help",
      "helpvalue": "<h5>Getting Started</h5><p>Configure your TESmart switches manually below, or enable network discovery to automatically find switches on your network.</p>"
    },
    "name",
    {
      "type": "section",
      "title": "Network Discovery",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "type": "help",
          "helpvalue": "<p><strong>Automatic Discovery:</strong> Enable this to automatically find TESmart switches on your local network. This can take 1-2 minutes on first startup.</p><p><em>Note:</em> Manually configured switches below will always be included, regardless of discovery settings.</p>"
        },
        "enableDiscovery",
        "discoverySubnet"
      ]
    },
    {
      "key": "switches",
      "type": "array",
      "title": "TESmart Switches",
      "description": "Configure your TESmart HDMI/KVM switches",
      "expandable": true,
      "expanded": false,
      "items": [
        "switches[].label",
        "switches[].ip_address",
        "switches[].model",
        "switches[].disable_polling",
        "switches[].polling_interval",
        "switches[].mute_buzzer",
        "switches[].led_timeout",
        {
          "type": "help",
          "helpvalue": "<script src='/plugins/homebridge-tesmart/migration.js'></script><p><strong>Using Legacy Input Format?</strong></p><p>If you have configured inputs using the old Input 1-16 format below, you can migrate them to the new array format:</p><button type='button' class='btn btn-primary' onclick='window.migrateInputs(0)'>Migrate Legacy Inputs to Array</button><p><small>This will copy your Input 1-16 configuration into the Inputs array above, allowing you to reorder them via drag &amp; drop.</small></p>"
        },
        {
          "key": "switches[].inputs",
          "type": "array",
          "title": "Inputs (Drag to Reorder)",
          "description": "Configure and reorder inputs via drag & drop. The order here determines how inputs appear in HomeKit.",
          "orderable": true,
          "buttonText": "Add Input",
          "expandable": true,
          "expanded": true,
          "items": [
            "switches[].inputs[].physicalInput",
            "switches[].inputs[].label",
            "switches[].inputs[].enabled"
          ]
        },
        {
          "key": "switches[]",
          "type": "section",
          "title": "Input Configuration (Legacy)",
          "description": "Legacy configuration format. Will be automatically migrated to the new Inputs array above.",
          "expandable": true,
          "expanded": false,
          "items": [
            "switches[].input1.label",
            "switches[].input1.enabled",
            "switches[].input2.label",
            "switches[].input2.enabled",
            "switches[].input3.label",
            "switches[].input3.enabled",
            "switches[].input4.label",
            "switches[].input4.enabled",
            "switches[].input5.label",
            "switches[].input5.enabled",
            "switches[].input6.label",
            "switches[].input6.enabled",
            "switches[].input7.label",
            "switches[].input7.enabled",
            "switches[].input8.label",
            "switches[].input8.enabled",
            "switches[].input9.label",
            "switches[].input9.enabled",
            "switches[].input10.label",
            "switches[].input10.enabled",
            "switches[].input11.label",
            "switches[].input11.enabled",
            "switches[].input12.label",
            "switches[].input12.enabled",
            "switches[].input13.label",
            "switches[].input13.enabled",
            "switches[].input14.label",
            "switches[].input14.enabled",
            "switches[].input15.label",
            "switches[].input15.enabled",
            "switches[].input16.label",
            "switches[].input16.enabled"
          ]
        }
      ]
    }
  ]
}
